{
  "name": "wordpress-trac-mcp-server",
  "version": "1.0.0",
  "description": "Read-only Model Context Protocol server for WordPress Core Trac",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:production": "wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env production",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test && pnpm run build && pnpm run build:production"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "trac",
    "cloudflare",
    "workers",
    "ai",
    "llm"
  ],
  "author": "James LePage",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@cloudflare/workers-types": "^4.20240529.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6",
    "wrangler": "^4.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/WordPress/trac-mcp"
  },
  "bugs": {
    "url": "https://github.com/WordPress/trac-mcp/issues"
  },
  "homepage": "https://github.com/WordPress/trac-mcp#readme"
}
