{
  "name": "wordpress-trac-mcp-server",
  "version": "1.0.0",
  "description": "Read-only Model Context Protocol server for WordPress Core Trac",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:production": "wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env production",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test && pnpm run build && pnpm run build:production"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "trac",
    "cloudflare",
    "workers",
    "ai",
    "llm"
  ],
  "author": "James LePage",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.29.0"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/WordPress/trac-mcp"
  },
  "bugs": {
    "url": "https://github.com/WordPress/trac-mcp/issues"
  },
  "homepage": "https://github.com/WordPress/trac-mcp#readme"
}
